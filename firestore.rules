rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true if the caller is a signed-in admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Returns true if the caller is the Firebase user that owns this club
    function isClubOwner(clubId) {
      return request.auth != null
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.uid == request.auth.uid;
    }

    // ── Admins ──────────────────────────────────────────────────────────────
    // Only admins can read the list; no client can write (use Admin SDK only)
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Gallery ─────────────────────────────────────────────────────────────
    // Anyone can view gallery posts; only admins can add / edit / delete
    match /gallery/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Clubs ────────────────────────────────────────────────────────────────
    // Public can list / read clubs (needed for home page and club pages)
    // Only admins can create or delete clubs
    // Club owners can update their own club document (logo, banner, etc.)
    match /clubs/{clubId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isClubOwner(clubId);
      allow delete: if isAdmin();

      // ── Tournaments ────────────────────────────────────────────────────────
      // Public read (results are public); club owner or admin can write
      match /tournaments/{tournamentId} {
        allow read:  if true;
        allow write: if isAdmin() || isClubOwner(clubId);

        // ── Entries (per-day race times) ────────────────────────────────────
        allow read:  if true;
        allow write: if isAdmin() || isClubOwner(clubId);

        match /entries/{entryId} {
          allow read:  if true;
          allow write: if isAdmin() || isClubOwner(clubId);
        }
      }

      // ── Participants ───────────────────────────────────────────────────────
      // Public read (shown on results pages); club owner or admin can write
      match /participants/{participantId} {
        allow read:  if true;
        allow write: if isAdmin() || isClubOwner(clubId);
      }

      // ── Members ────────────────────────────────────────────────────────────
      // Private: only the owning club or an admin can read or write
      match /members/{memberId} {
        allow read:  if isAdmin() || isClubOwner(clubId);
        allow write: if isAdmin() || isClubOwner(clubId);
      }
    }
  }
}
